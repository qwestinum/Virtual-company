# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# WSL/Windows alternate data stream markers on copied files
*:Zone.Identifier

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — on ignore les fichiers de secrets (*.local), mais on TRACE
# .env.example (template public documentant les variables d'environnement).
# `.env.local*` couvre aussi les typos/backups (.env.localT, .env.local.bak…) :
# un fichier de secrets ne doit JAMAIS pouvoir être committé par accident.
.env*.local
.env.local*
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bench CV Analyzer — données et sorties LOCALES :
# - les CV de test (cv*.txt/.pdf) sont des données personnelles, jamais committés ;
# - les sorties de bench (openai.json, bench-cv-*.json) sont dérivées ;
# - seule la fiche de scoring fixture (bench/fiche.json) est tracée.
bench-cv-*.json
bench/*
!bench/fiche.json

# scripts de smoke-test locaux (brouillons de dev, jamais importés par src/)
/*-smoke.ts
/*-smoke.mjs

# journal d'import vivier (script npm run import:vivier) — contient des EMAILS de
# candidats (donnée personnelle) : JAMAIS committé. Couvre aussi le .dryrun.json.
.import-vivier-journal*.json

# scripts de diagnostic JETABLES (`scripts/*-tmp.ts`) : écrits pour un incident
# précis, ils lisent des creds d'environnement (`.env.localX`) et portent des
# identifiants/noms de candidats RÉELS. Ils restent sur la machine du dev, ils
# n'entrent JAMAIS dans le dépôt. Cf. docs/sessions/SESSION_AUDIT_LOTS_2026-07-17_26.md.
scripts/*-tmp.ts
scripts/*-tmp[0-9].ts

# aperçu JETABLE de l'identité ORQA (données mockées) : `next build` en ferait
# une page PUBLIQUE en prod (elle n'est pas dans PROTECTED_PREFIXES du proxy).
# À supprimer — cf. docs/BACKLOG.md et docs/audit/audit-orqa.md (SEC-7).
/src/app/candidatures-apercu/

# fichier utilitaire de diagnostic du 18/08 — ne teste rien, à supprimer.
/tests/regression/zz-dbg.test.ts
